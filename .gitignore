# ========================================
# Python & Backend
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Virtual Environments (Strictly anchored so it doesn't break frontend)
/venv/
/.venv/
venv/
.venv/

# ========================================
# IDE & OS
# ========================================
.vscode/
Thumbs.db
.DS_Store

# ========================================
# Environment Variables & Logs
# ========================================
.env
.env.*
*.log
logs/

# ========================================
# Jupyter Notebooks
# ========================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ========================================
# Dataset & AI Models
# ========================================
dataset/images/**/*.jpg
dataset/images/**/*.jpeg
dataset/images/**/*.png
!dataset/images/*/.gitkeep

# PyTorch and general large files
*.pt
*.pth
*.bin

# ========================================
# Frontend (Next.js)
# ========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/npm-debug.log*

# ========================================
# EXPLICIT ALLOWANCES (Bulletproof Section)
# ========================================
# Force Git to NEVER ignore these critical frontend files/folders, 
# even if a bad rule is added later.
!frontend/lib/
!frontend/src/
!frontend/components/
!frontend/tsconfig.json
!frontend/jsconfig.json
!frontend/package.json
!frontend/package-lock.json

# ========================================
# Databases & Temp Files
# ========================================
*.sqlite3
*.db
*.bak
*.tmp
cache/
temp/
tmp/